DATABASE_URL=            # Neon
BLOB_READ_WRITE_TOKEN=   # Vercel Blob
ADMIN_PASSWORD=          # รหัสหลังบ้านของเจ้าของ: อย่างน้อย 16 ตัวอักษร แนะนำสุ่มยาว 24+ ตัว (เช่น node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))") สั้นกว่า 16 หรือไม่ตั้ง = ล็อกอิน owner ไม่ได้
SESSION_SECRET=          # สุ่มอย่างน้อย 32 ตัวอักษร ไม่มีค่าสำรอง: ไม่ตั้ง = หลังบ้านปิด และ production รับออเดอร์ไม่ได้
CRON_SECRET=             # ป้องกัน /api/cron/reset: สุ่มอย่างน้อย 16 ตัวอักษร (เช่น node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))") ไม่ตั้ง/สั้นกว่า 16 = endpoint ปฏิเสธทุกคำขอ; ตั้งใน Vercel ทั้ง Production/Preview แล้ว Vercel ส่ง Bearer ให้เอง
DEMO_MODE=true           # true = เปิดปุ่ม "ลองหลังบ้านแบบเดโม"
